#!/usr/bin/env bash
set -euo pipefail

export PYTHONPATH="${PYTHONPATH:-}:src"

echo "=============================================================="
echo "SATURNI QUALITY GATE"
echo "=============================================================="

echo
echo "1. Syntax"
python -m py_compile   saturni.py   src/saturni_rag/__init__.py   src/saturni_rag/core.py   src/saturni_rag/cli.py
echo "PASS: syntax"

echo
echo "2. Tests"
python -m pytest   tests   test_citation_integrity.py   test_retrieval_diversity.py   test_retrieval_threshold.py   test_runtime_hardening.py   -q

echo
echo "3. Metrics JSON"
./scripts/richmack-metrics --json | python -m json.tool >/dev/null
echo "PASS: metrics JSON"

echo
echo "4. Engineering metrics"
./scripts/richmack-metrics

echo
echo "PASS: Saturni quality gate"
